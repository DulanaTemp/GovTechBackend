{
  "info": {
    "name": "GovTech Smart Parking API",
    "description": "Complete collection for the GovTech Smart Parking backend: OTP login, proximity-based parking discovery, ticketing, and payments.\n\nUsage:\n1. Set the `baseUrl` collection variable (defaults to http://localhost:8080).\n2. Run `Auth > Request OTP`, then read the OTP from the server logs (dev mode logs it).\n3. Run `Auth > Verify OTP` with that code. The returned JWT is auto-saved to the `accessToken` variable.\n4. All protected requests inherit the Bearer token automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "phoneNumber",
      "value": "+6591234567",
      "type": "string"
    },
    {
      "key": "otp",
      "value": "",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "lotId",
      "value": "",
      "type": "string"
    },
    {
      "key": "ticketId",
      "value": "",
      "type": "string"
    },
    {
      "key": "paymentId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Request OTP",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"{{phoneNumber}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/otp/request",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "otp", "request"]
            },
            "description": "Step 1: generates a one-time code and sends it via SMS. In dev mode the code is printed to the server logs."
          }
        },
        {
          "name": "Verify OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    if (json.accessToken) {",
                  "        pm.collectionVariables.set('accessToken', json.accessToken);",
                  "        console.log('Saved accessToken to collection variable.');",
                  "    }",
                  "    if (json.user && json.user.id) {",
                  "        pm.collectionVariables.set('userId', json.user.id);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"{{phoneNumber}}\",\n  \"otp\": \"{{otp}}\",\n  \"name\": \"Test User\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/otp/verify",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "otp", "verify"]
            },
            "description": "Step 2: validates the OTP, provisions the user on first login, and returns a JWT. The token is auto-saved to the `accessToken` collection variable."
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "me"]
            },
            "description": "Returns the authenticated user's profile."
          }
        }
      ]
    },
    {
      "name": "Parking Lots",
      "item": [
        {
          "name": "Find Nearby Available",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/parking-lots/nearby?latitude=1.3521&longitude=103.8198&radiusKm=5",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "parking-lots", "nearby"],
              "query": [
                { "key": "latitude", "value": "1.3521" },
                { "key": "longitude", "value": "103.8198" },
                { "key": "radiusKm", "value": "5" }
              ]
            },
            "description": "Core feature: returns active lots with available spots within the radius (km), nearest first."
          }
        },
        {
          "name": "List All Lots",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/parking-lots",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "parking-lots"]
            }
          }
        },
        {
          "name": "Get Lot By Id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/parking-lots/{{lotId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "parking-lots", "{{lotId}}"]
            }
          }
        },
        {
          "name": "Create Lot",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const json = pm.response.json();",
                  "    if (json.id) {",
                  "        pm.collectionVariables.set('lotId', json.id);",
                  "        console.log('Saved lotId: ' + json.id);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Marina Bay Car Park\",\n  \"latitude\": 1.28530000,\n  \"longitude\": 103.86000000,\n  \"totalSpots\": 100,\n  \"availableSpots\": 100,\n  \"hourlyRate\": 2.50\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/parking-lots",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "parking-lots"]
            },
            "description": "Creates a parking lot. The new lot id is auto-saved to the `lotId` variable."
          }
        }
      ]
    },
    {
      "name": "Tickets",
      "item": [
        {
          "name": "Start Parking Session",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const json = pm.response.json();",
                  "    if (json.id) {",
                  "        pm.collectionVariables.set('ticketId', json.id);",
                  "        console.log('Saved ticketId: ' + json.id);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lotId\": \"{{lotId}}\",\n  \"vehicleNumber\": \"SGX1234A\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/tickets",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "tickets"]
            },
            "description": "Step 4: selects a lot, records start time, reserves a spot, and issues a ticket. The ticket id is auto-saved to `ticketId`."
          }
        },
        {
          "name": "List My Tickets",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/tickets",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "tickets"]
            }
          }
        },
        {
          "name": "Get Ticket By Id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/tickets/{{ticketId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "tickets", "{{ticketId}}"]
            }
          }
        },
        {
          "name": "Complete Parking Session",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/tickets/{{ticketId}}/complete",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "tickets", "{{ticketId}}", "complete"]
            },
            "description": "Step 5: ends the session, computes billable hours and total amount, and releases the spot."
          }
        },
        {
          "name": "Cancel Parking Session",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/tickets/{{ticketId}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "tickets", "{{ticketId}}", "cancel"]
            },
            "description": "Cancels an active session without charge and releases the spot."
          }
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "Pay For Ticket",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const json = pm.response.json();",
                  "    if (json.id) {",
                  "        pm.collectionVariables.set('paymentId', json.id);",
                  "        console.log('Saved paymentId: ' + json.id);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ticketId\": \"{{ticketId}}\",\n  \"paymentMethod\": \"CARD\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/payments",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "payments"]
            },
            "description": "Step 6: processes payment for the ticket's total amount and sends an SMS receipt on success. The payment id is auto-saved to `paymentId`."
          }
        },
        {
          "name": "List My Payments",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/payments",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "payments"]
            }
          }
        },
        {
          "name": "Get Payment By Id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/payments/{{paymentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "payments", "{{paymentId}}"]
            }
          }
        }
      ]
    }
  ]
}
